from skimage import io, filters, color

balneario = io.imread('assets/Balneario.png')
if balneario.ndim == 3:
    balneario = balneario[:, :, 0]

limiar = filters.threshold_otsu(balneario)
balneario_bin = balneario > limiar

itapema = io.imread('assets/Itapema.png')
if itapema.ndim == 3:
    itapema = itapema[:, :, 0]

limiar2 = filters.threshold_otsu(itapema)
itapema_bin = itapema > limiar2

